{
  "name": "music-for-url-cloudflare",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "npm --prefix ../web run build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "predev": "npm run build:assets",
    "dev": "wrangler dev",
    "predeploy": "npm run build:assets",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute music-for-url --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute music-for-url --remote --file=./schema.sql",
    "db:backfill": "wrangler d1 execute music-for-url --remote --file=./migrations/0001-backfill-play-stats.sql",
    "db:migrate:stats": "wrangler d1 execute music-for-url --remote --file=./migrations/0002-site-stats.sql",
    "db:migrate:qr": "wrangler d1 execute music-for-url --remote --file=./migrations/0003-qr-sessions-kugou.sql",
    "test": "node --test tests/worker.test.js tests/platforms.test.js tests/platform-parity.test.js tests/netease.test.js tests/packed-audio.test.js tests/workspace.test.js tests/qqmusic.test.js"
  },
  "dependencies": {
    "crypto-js": "4.2.0",
    "node-forge": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
