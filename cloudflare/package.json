{
  "name": "music-for-url-cloudflare",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "npm --prefix ../web run build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "predev": "npm run build:assets",
    "dev": "wrangler dev",
    "predeploy": "npm run build:assets",
    "deploy": "wrangler deploy",
    "db:migrate": "node scripts/migrate.mjs",
    "db:local": "node scripts/migrate.mjs --local",
    "db:remote": "node scripts/migrate.mjs --remote",
    "db:backfill": "node scripts/migrate.mjs --remote",
    "db:migrate:stats": "node scripts/migrate.mjs --remote",
    "db:migrate:qr": "node scripts/migrate.mjs --remote",
    "test:migrations:local": "node --test tests/migrations-local.test.js",
    "test": "node --test tests/worker.test.js tests/platforms.test.js tests/platform-parity.test.js tests/netease.test.js tests/packed-audio.test.js tests/workspace.test.js tests/qqmusic.test.js tests/migrations.test.js"
  },
  "dependencies": {
    "crypto-js": "4.2.0",
    "node-forge": "1.4.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
