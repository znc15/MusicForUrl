{
  "name": "music-for-url",
  "version": "2.1.1",
  "description": "多平台歌单转播放链接 · Cloudflare Workers + D1",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "npm --prefix cloudflare run dev",
    "dev": "npm --prefix cloudflare run dev",
    "check": "npm --prefix web run check",
    "test": "node scripts/test.cjs && npm --prefix cloudflare test",
    "build": "npm --prefix web run build",
    "build:worker": "npm run build && npm --prefix cloudflare run build:worker",
    "docs:build": "npm --prefix website run build",
    "deploy": "npm --prefix cloudflare run deploy"
  },
  "keywords": [
    "netease",
    "music",
    "vrchat",
    "m3u8",
    "playlist"
  ],
  "author": "",
  "license": "MIT"
}
